<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixture/**/*.cs" />
    <ProjectReference Include="../../spikes/CecilInstrumentation/CecilInstrumentation.csproj" />
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <Target Name="CopyFixture" AfterTargets="Build">
    <ItemGroup><FixtureFiles Include="Fixture/bin/$(Configuration)/net8.0/Fixture.dll;Fixture/bin/$(Configuration)/net8.0/Fixture.pdb" /></ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutputPath)fixture" />
  </Target>
</Project>
