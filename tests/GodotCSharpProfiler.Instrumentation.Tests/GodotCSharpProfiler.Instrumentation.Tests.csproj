<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../addons/godot_csharp_profiler/Runtime/Instrumentation/InstrumentationRecorder.cs" Link="Runtime/InstrumentationRecorder.cs" />
    <Compile Remove="Fixture/**/*.cs" />
    <ProjectReference Include="../../src/GodotCSharpProfiler.Fody/GodotCSharpProfiler.Fody.csproj" />
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="FodyHelpers" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CopyFixture" AfterTargets="Build">
    <ItemGroup><FixtureFiles Include="Fixture/bin/$(Configuration)/net8.0/Fixture.dll;Fixture/bin/$(Configuration)/net8.0/Fixture.pdb" /></ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutputPath)fixture" />
  </Target>
</Project>
