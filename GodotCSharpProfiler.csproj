<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Apeworks.GodotCSharpProfiler</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Standalone tests, feasibility proofs, and build tools own their dependencies in separate projects. -->
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="spikes/**/*.cs" />
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="scripts/**/*.cs" />
    <Compile Remove="artifacts/**/*.cs" />
  </ItemGroup>
  <Import Project="addons/godot_csharp_profiler/assets/GodotCSharpProfiler.Dependencies.props" />
</Project>
